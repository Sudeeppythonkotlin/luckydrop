rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /tickets/{id} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code.matches('^[A-Z][0-9]{4}$');
    }
    match /entries/{id} {
      allow read: if request.auth != null && id.matches('.*_' + request.auth.uid);
      allow create: if request.auth != null && id.matches('.*_' + request.auth.uid);
    }
  }
}
